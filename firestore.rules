rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isDeveloper() {
      return isAuthenticated() && request.auth.token.role == 'developer';
    }
    
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'admin' || request.auth.token.role == 'developer');
    }

    // Public collections (Read-only for public, Read/Write for Admin/Dev)
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /stages/{stageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /houses/{houseId} {
      allow read: if true;
      allow write: if isDeveloper(); 
    }
    match /housePoints/{pointId} {
      allow read: if true;
      allow write: if isDeveloper(); // Admin SDK does writes for points during publishing
    }
    match /results/{resultId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /liveFeed/{feedId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Private Collections
    match /resultDrafts/{draftId} {
      allow read, write: if isAdmin();
    }
    match /auditLogs/{logId} {
      allow read: if isDeveloper();
      allow write: if isAdmin();
    }
    match /users/{userId} {
      allow read, write: if isDeveloper();
    }
    match /systemSettings/{settingId} {
      allow read, write: if isDeveloper();
    }
  }
}
